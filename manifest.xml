<?xml version="1.0"?>
<iq:manifest version="3" xmlns:iq="http://www.garmin.com/xml/connectiq">
  <!--
    Watch Key. A direct Bluetooth LE key for Tesla vehicles.

    minApiLevel 3.1.0 is the floor for Toybox.BluetoothLowEnergy. Note that
    Garmin's monetization programme only covers System 7 devices, so the
    sellable device set is narrower than the compatible one - see README.
  -->
  <iq:application
      id="edba547a332141a5a3cd6199f9e2bf4c"
      type="watch-app"
      name="@Strings.AppName"
      entry="WatchKeyApp"
      launcherIcon="@Drawables.LauncherIcon"
      minApiLevel="3.1.0">
    <!--
      Every product listed here must support BluetoothLowEnergy. Verify with
      "Monkey C: Edit Products" in VS Code before the first store submission -
      an unsupported product id fails the build.
    -->
    <iq:products>
      <iq:product id="epix2"/>
      <iq:product id="fenix7"/>
      <iq:product id="fenix7s"/>
      <iq:product id="fenix7x"/>
      <iq:product id="fr255"/>
      <iq:product id="fr265"/>
      <iq:product id="fr955"/>
      <iq:product id="fr965"/>
      <iq:product id="venu2"/>
      <iq:product id="venu2s"/>
      <iq:product id="venu3"/>
      <iq:product id="venu3s"/>
      <iq:product id="vivoactive5"/>
    </iq:products>
    <iq:permissions>
      <iq:uses-permission id="BluetoothLowEnergy"/>
    </iq:permissions>
    <iq:languages>
      <iq:language>eng</iq:language>
    </iq:languages>
    <iq:barrels/>
  </iq:application>
</iq:manifest>
